# Copy this file to .env. Never commit real keys.
# Generate local wallet keys with: npx tsx hedge/keys.ts
SELLER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Optional Groq key. Without it, the agent uses rules.
GROQ_API_KEY=
NO_LLM=0
GROQ_MODEL=openai/gpt-oss-120b

# Demo settings
BUDGET_SATS=20000
PROTECT_SATS=200000
MAX_PURCHASE_SATS=5000
PRICE_MODE=replay
STEP_SECONDS=15